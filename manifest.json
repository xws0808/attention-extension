{
  "manifest_version": 3,
  "name": "Focus Coach",
  "version": "1.0",
  "description": "Trains sustained attention while you watch YouTube, using your own viewing behavior to set progressively increasing focus targets.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
